@OnkyoIn.Web_HostAddress = http://localhost:5241

### Discover an Onkyo device (proxied to OnkyoIn.Control)
GET {{OnkyoIn.Web_HostAddress}}/api/device/discover
Accept: application/json

### Read the current device state
GET {{OnkyoIn.Web_HostAddress}}/api/device/state?ipAddress=192.168.1.100
Accept: application/json

### Read the input sources available on the device (proxied to OnkyoIn.Control)
GET {{OnkyoIn.Web_HostAddress}}/api/device/inputs?ipAddress=192.168.1.100
Accept: application/json

### Select an input source (see the /inputs endpoint for valid ids)
POST {{OnkyoIn.Web_HostAddress}}/api/device/input
Content-Type: application/json

{
  "ipAddress": "192.168.1.100",
  "inputId": "cd"
}

### Power on the device
POST {{OnkyoIn.Web_HostAddress}}/api/device/power-on
Content-Type: application/json

{
  "ipAddress": "192.168.1.100"
}

### Toggle the device power (proxied to OnkyoIn.Control)
POST {{OnkyoIn.Web_HostAddress}}/api/device/power/toggle
Content-Type: application/json

{
  "ipAddress": "192.168.1.100"
}

### Raise the volume
POST {{OnkyoIn.Web_HostAddress}}/api/device/volume/up
Content-Type: application/json

{
  "ipAddress": "192.168.1.100"
}

### Lower the volume
POST {{OnkyoIn.Web_HostAddress}}/api/device/volume/down
Content-Type: application/json

{
  "ipAddress": "192.168.1.100"
}
